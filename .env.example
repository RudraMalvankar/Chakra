# Razorpay Credentials (Optional / Sandbox)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Gemini AI API Key (For AI Triage & Voice script generation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Runtime Modes
DRY_RUN=false
USE_MOCK_RAZORPAY=true
MOCK_RAZORPAY_URL=http://localhost:8000/api/mock-razorpay

# Database (Neon PostgreSQL or local SQLite for testing)
DATABASE_URL=postgresql://user:password@ep-sample.aws.neon.tech/neondb?sslmode=require

# Twilio Voice / SMS (Optional / Sandbox)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WEBHOOK_BASE_URL=https://your-domain.com
USE_MOCK_VOICE=true
