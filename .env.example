# Environment Variables Example
# Copy to .env and fill in your values

# Application Mode
DRY_RUN=false

# Neon Postgres Database (get from https://console.neon.tech)
DATABASE_URL=postgresql+psycopg://user:password@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=require

# Razorpay Test Mode Keys (get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Twilio Credentials (optional, for Voice Recovery)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WEBHOOK_BASE_URL=

# Mock / Gateway Settings
USE_MOCK_RAZORPAY=true
MOCK_RAZORPAY_URL=http://localhost:8002

# Frontend Config
VITE_API_BASE_URL=http://localhost:8001
