# Environment Variables Example
# Copy to .env and fill in your values

# Application Mode
DRY_RUN=false

# Razorpay Test Mode Keys (get from https://dashboard.razorpay.com/app/keys)
# Leave empty to use the mock server
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Gemini API Key (get from https://aistudio.google.com/apikey)
# Leave empty to skip Gemini (all cases will be rule-based)
GEMINI_API_KEY=

# Use Mock Server (set to false to hit real Razorpay test mode)
USE_MOCK_RAZORPAY=true
MOCK_RAZORPAY_URL=http://localhost:8001
