# Environment Variables Example
# Copy to .env and fill in your values

# Application Mode
DRY_RUN=false

# Neon Postgres Database
DATABASE_URL=postgresql+psycopg://user:password@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=require

# Razorpay Test Mode Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Gemini
# Google Gemini API key
GEMINI_API_KEY=

# Optional model override
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Twilio
# Twilio Account SID
TWILIO_ACCOUNT_SID=
# Twilio Auth Token
TWILIO_AUTH_TOKEN=
# Twilio phone number used as caller ID
TWILIO_FROM_NUMBER=

# Public URL reachable by Twilio
# Public HTTPS URL Twilio can reach, for example:
# https://xxxx.ngrok-free.app
TWILIO_WEBHOOK_BASE_URL=

# Optional browser voice feature toggle
USE_MOCK_VOICE=false

# Mock / Gateway Settings
USE_MOCK_RAZORPAY=true
MOCK_RAZORPAY_URL=http://localhost:8002

# Frontend Config
VITE_API_BASE_URL=http://localhost:8001
