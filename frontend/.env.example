# Local development (recommended): leave unset so the Vite proxy forwards
# /api and /health to http://localhost:8001 (see vite.config.ts).
#
# Split deploy / production: set an absolute backend origin, e.g.:
# VITE_API_BASE_URL=https://api.example.com
#
# Do not hardcode localhost into React runtime logic.
# VITE_API_BASE_URL=
