{
  "version": "1.0",
  "description": "18 hand-labeled edge cases for Chakra triage accuracy evaluation. Each case represents a real Razorpay error scenario with the expected action based on RBI e-mandate rules and card network constraints.",
  "labeled_by": "Chakra team",
  "labeled_at": "2026-09-02",
  "cases": [
    {
      "id": 1,
      "name": "Standard insufficient_funds under AFA threshold",
      "payment": {
        "payment_id": "eval_001",
        "amount": 49900,
        "currency": "INR",
        "error_code": "insufficient_funds",
        "is_first_transaction": false,
        "metadata": {
          "bank_name": "HDFC",
          "network": "visa",
          "retries_this_month": 1,
          "pre_debit_alerts_ignored": 0
        }
      },
      "expected_action": "retry",
      "expected_reason_contains": "insufficient_funds",
      "rationale": "Below 15K AFA threshold, not first transaction, retries well under Visa 15/30d cap. Standard retry with salary-day timing."
    },
    {
      "id": 2,
      "name": "AFA threshold exceeded (16K INR)",
      "payment": {
        "payment_id": "eval_002",
        "amount": 1600000,
        "currency": "INR",
        "error_code": "insufficient_funds",
        "is_first_transaction": false,
        "metadata": {
          "bank_name": "SBI",
          "network": "mastercard",
          "retries_this_month": 0,
          "pre_debit_alerts_ignored": 0
        }
      },
      "expected_action": "send_payment_link",
      "expected_reason_contains": "afa_threshold",
      "rationale": "Amount 16K > 15K standard AFA threshold. Must send OTP link, never silent retry."
    },
    {
      "id": 3,
      "name": "First transaction requires AFA",
      "payment": {
        "payment_id": "eval_003",
        "amount": 29900,
        "currency": "INR",
        "error_code": "card_declined",
        "is_first_transaction": true,
        "metadata": {
          "bank_name": "ICICI",
          "network": "visa",
          "retries_this_month": 0,
          "pre_debit_alerts_ignored": 0
        }
      },
      "expected_action": "send_payment_link",
      "expected_reason_contains": "first_transaction",
      "rationale": "RBI rule: first transaction on any mandate always requires full AFA (OTP). No silent retry allowed."
    },
    {
      "id": 4,
      "name": "Fraud flag - hard escalate",
      "payment": {
        "payment_id": "eval_004",
        "amount": 200000,
        "currency": "INR",
        "error_code": "fraud_flag",
        "is_first_transaction": false,
        "metadata": {
          "bank_name": "Axis",
          "network": "mastercard",
          "retries_this_month": 0,
          "pre_debit_alerts_ignored": 0
        }
      },
      "expected_action": "block",
      "expected_reason_contains": "fraud_flag",
      "rationale": "Hard decline. Retrying a fraud-flagged payment is offense-capable and disqualified per Track 02 rules. Must escalate to human."
    },
    {
      "id": 5,
      "name": "Mandate revoked - hard escalate",
      "payment": {
        "payment_id": "eval_005",
        "amount": 99900,
        "currency": "INR",
        "error_code": "mandate_revoked",
        "is_first_transaction": false,
        "metadata": {
          "bank_name": "HDFC",
          "network": "visa",
          "retries_this_month": 0,
          "pre_debit_alerts_ignored": 0
        }
      },
      "expected_action": "block",
      "expected_reason_contains": "mandate_revoked",
      "rationale": "Customer explicitly revoked the mandate. Retrying violates consent. Must escalate."
    },
    {
      "id": 6,
      "name": "High pre-debit alerts ignored (churn signal)",
      "payment": {
        "payment_id": "eval_006",
        "amount": 120000,
        "currency": "INR",
        "error_code": "payment_timed_out",
        "is_first_transaction": false,
        "metadata": {
          "bank_name": "SBI",
          "network": "rupay",
          "retries_this_month": 0,
          "pre_debit_alerts_ignored": 3
        }
      },
      "expected_action": "escalate",
      "expected_reason_contains": "alerts_ignored",
      "rationale": "Customer ignored 3+ pre-debit alerts - strong churn signal. Burning a network retry slot on a likely-churned customer is wasteful. Escalate to human win-back path."
    },
    {
      "id": 7,
      "name": "Visa network retry cap reached",
      "payment": {
        "payment_id": "eval_007",
        "amount": 99900,
